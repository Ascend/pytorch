#include "NPUSHMEMSymmetricMemoryKernels.hpp"
#include "kernel_operator.h"
#include "acl/acl.h"

namespace {

// This is the hardware capability boundary, not the signal protocol. CANN 9.2
// implements scalar GM AtomicCas only for this ISA (kernel_operator_atomic_intf_impl.h).
// A new ISA must supply equivalent remote-GM atomics, ordering and a documented
// counter unit here before it can run the otherwise unchanged protocol. Never
// replace CAS with a load/store or a cache-line writeback: adjacent 4-byte signal
// slots may be modified concurrently by other devices.
#if defined(__NPU_ARCH__) && __NPU_ARCH__ != 3510
#error "NPUSHMEM signals require a validated remote uint32 CAS and system-counter adapter for this NPU ISA"
#endif

// The supported SYS_CNT counter is measured in nanoseconds, independently of
// the AI Core clock. Keep this unit with the primitive adapter rather than in
// put/wait/barrier; older ISAs use a different counter rate.
constexpr uint64_t ticks_per_ms = 1000000;

__aicore__ inline uint64_t clock_ticks() {
  return static_cast<uint64_t>(AscendC::GetSystemCycle());
}

__aicore__ inline bool try_publish(__gm__ uint32_t* slot) {
  // Finish preceding memory operations before publishing. All observations of
  // a slot use native GM CAS, including failed attempts; no scalar cache load
  // or non-atomic zeroing is permitted on the shared signal pad.
  AscendC::DataSyncBarrier<AscendC::MemDsbT::ALL>();
  return AscendC::AtomicCas<uint32_t>(slot, 0u, 1u) == 0u;
}

__aicore__ inline bool try_consume(__gm__ uint32_t* slot) {
  if (AscendC::AtomicCas<uint32_t>(slot, 1u, 0u) != 1u) {
    return false;
  }
  // Do not let following memory operations pass a successful consumption.
  AscendC::DataSyncBarrier<AscendC::MemDsbT::ALL>();
  return true;
}

__aicore__ inline void finish() {
  // Also order the final scalar atomic before completion of this stream task.
  AscendC::DataSyncBarrier<AscendC::MemDsbT::ALL>();
}

// Each peer advances independently. A failed CAS must not prevent polling
// another peer, and must not reset this phase's timeout start.
enum class Phase : uint8_t { Put, Wait, Done };
struct PeerState {
  Phase phase;
  uint64_t started;
};

__aicore__ inline bool timed_out(uint64_t now, uint64_t started, uint64_t timeout_ms, uint64_t ticks_per_ms) {
  if (timeout_ms == 0) {
    return false;
  }
  const uint64_t elapsed = now - started;
  if (ticks_per_ms == 0) {
    return elapsed != 0;
  }
  // Compare against the mathematical product without overflowing it. Use
  // a strict > boundary, including a fractional millisecond.
  const uint64_t whole_ms = elapsed / ticks_per_ms;
  return whole_ms > timeout_ms || (whole_ms == timeout_ms && elapsed % ticks_per_ms != 0);
}

__aicore__ inline void advance(PeerState& state, uint64_t now) {
  if (state.phase == Phase::Put) {
    state.phase = Phase::Wait;
    state.started = now;
  } else if (state.phase == Phase::Wait) {
    state.phase = Phase::Done;
  }
}

} // namespace

extern "C" __global__ __aicore__ void npushmem_put_signal(
    GM_ADDR signal_pad,
    uint64_t signal_index,
    uint64_t timeout_ms) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  auto* signal = reinterpret_cast<__gm__ uint32_t*>(signal_pad) + signal_index;
  const uint64_t started = clock_ticks();
  while (!try_publish(signal)) {
    if (timed_out(clock_ticks(), started, timeout_ms, ticks_per_ms)) {
      AscendC::printf("[FATAL] SymmetricMemory::put_signal timed out after %lu milliseconds\n", timeout_ms);
      AscendC::Trap();
    }
  }
  finish();
}

extern "C" __global__ __aicore__ void npushmem_wait_signal(
    GM_ADDR signal_pad,
    uint64_t signal_index,
    uint64_t timeout_ms) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  auto* signal = reinterpret_cast<__gm__ uint32_t*>(signal_pad) + signal_index;
  const uint64_t started = clock_ticks();
  while (!try_consume(signal)) {
    if (timed_out(clock_ticks(), started, timeout_ms, ticks_per_ms)) {
      AscendC::printf("[FATAL] SymmetricMemory::wait_signal timed out after %lu milliseconds\n", timeout_ms);
      AscendC::Trap();
    }
  }
  finish();
}

extern "C" __global__ __aicore__ void npushmem_barrier(
    GM_ADDR signal_pads,
    GM_ADDR peer_states,
    int channel,
    int rank,
    int world_size,
    uint64_t timeout_ms) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  // One AIV polls all peers without waiting inside an individual peer's step.
  // This avoids relying on simultaneous residency of a block for every peer.
  // Scratch belongs to this invocation, not to a channel or a shared handle.
  auto* pads = reinterpret_cast<__gm__ uint64_t*>(signal_pads);
  auto* states = reinterpret_cast<__gm__ PeerState*>(peer_states);
  const uint64_t row = static_cast<uint64_t>(channel) * world_size;
  const uint64_t started = clock_ticks();
  for (int peer = 0; peer < world_size; ++peer) {
    states[peer].phase = peer == rank ? Phase::Done : Phase::Put;
    states[peer].started = started;
  }
  int remaining = world_size - 1;
  while (remaining != 0) {
    for (int peer = 0; peer < world_size; ++peer) {
      PeerState state{states[peer].phase, states[peer].started};
      if (state.phase == Phase::Done) {
        continue;
      }
      const bool publishing = state.phase == Phase::Put;
      auto* slot = publishing ? reinterpret_cast<__gm__ uint32_t*>(pads[peer]) + row + rank
                              : reinterpret_cast<__gm__ uint32_t*>(pads[rank]) + row + peer;
      const bool success = publishing ? try_publish(slot) : try_consume(slot);
      const uint64_t now = clock_ticks();
      // A successful CAS wins even at the deadline.
      // WAIT receives its own full interval after this peer's PUT succeeds.
      if (success) {
        advance(state, now);
        states[peer].phase = state.phase;
        states[peer].started = state.started;
        if (state.phase == Phase::Done) {
          --remaining;
        }
      } else if (timed_out(now, state.started, timeout_ms, ticks_per_ms)) {
        AscendC::printf(
            "[FATAL] SymmetricMemory::barrier rank %d peer %d channel %d phase %d timed out after %lu milliseconds\n",
            rank,
            peer,
            channel,
            static_cast<int>(state.phase),
            timeout_ms);
        AscendC::Trap();
      }
    }
  }
  finish();
}

namespace {
int32_t launch_kernel(const void* kernel, void** arguments, void* stream) {
  // Resolve the compiler's registered image rather than assembling a raw ABI
  // argument buffer. ACL validates that this image can execute on the device;
  // propagate resolution/submission errors instead of hiding them in a stub.
  aclrtFuncHandle function = nullptr;
  const auto error = aclrtGetFuncBySymbol(kernel, &function);
  if (error != ACL_SUCCESS) {
    return error;
  }
  aclrtLaunchKernelAttr attribute{};
  attribute.id = ACL_RT_LAUNCH_KERNEL_ATTR_DYN_UBUF_SIZE;
  attribute.value.dynUBufSize = 0;
  aclrtLaunchKernelCfg config{&attribute, 1};
  return aclrtLaunchKernelWithArgsArray(function, 1, stream, &config, arguments);
}
} // namespace

namespace c10d {
namespace symmetric_memory {

size_t get_npushmem_barrier_workspace_size(int world_size) {
  return static_cast<size_t>(world_size) * sizeof(PeerState);
}

int32_t launch_npushmem_put_signal(
    void* signal_pad,
    uint64_t signal_index,
    uint64_t timeout_ms,
    void* stream) {
  void* arguments[] = {&signal_pad, &signal_index, &timeout_ms};
  return launch_kernel(reinterpret_cast<const void*>(npushmem_put_signal), arguments, stream);
}

int32_t launch_npushmem_wait_signal(
    void* signal_pad,
    uint64_t signal_index,
    uint64_t timeout_ms,
    void* stream) {
  void* arguments[] = {&signal_pad, &signal_index, &timeout_ms};
  return launch_kernel(reinterpret_cast<const void*>(npushmem_wait_signal), arguments, stream);
}

int32_t launch_npushmem_barrier(
    void** signal_pads,
    void* peer_states,
    int channel,
    int rank,
    int world_size,
    uint64_t timeout_ms,
    void* stream) {
  void* arguments[] = {&signal_pads, &peer_states, &channel, &rank, &world_size, &timeout_ms};
  return launch_kernel(reinterpret_cast<const void*>(npushmem_barrier), arguments, stream);
}

} // namespace symmetric_memory
} // namespace c10d
