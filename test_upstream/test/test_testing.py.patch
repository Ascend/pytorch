+        ).compare()
+
+        different_stride = expected.t().contiguous().t()
+        with self.assertRaises(ErrorMeta):
+            TensorLikePair(actual, different_stride, check_stride=True).compare()
+        TensorLikePair(actual, different_stride).compare()
